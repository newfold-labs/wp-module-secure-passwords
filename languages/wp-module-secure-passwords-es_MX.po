#: bootstrap.php:22
msgid "Secure Passwords"
msgstr "Contraseñas seguras"

#: includes/insecure-password-screen.php:17
#: includes/insecure-password-screen.php:24
msgid "Insecure password detected"
msgstr "Contraseña insegura detectada"

#: includes/insecure-password-screen.php:28
msgid "This does not mean your user account or WordPress site has been compromised."
msgstr "Esto no significa que tu cuenta de usuario o sitio de WordPress haya sido comprometido."

#: includes/insecure-password-screen.php:32
msgid "The password you are using was found in a database of insecure passwords. This likely means that that it was part of a previously reported data breach, making it much more likely to be used in attempts by bad actors to compromise sites."
msgstr "La contraseña que estás usando fue encontrada en una base de datos de contraseñas inseguras. Esto probablemente significa que fue parte de una brecha de datos previamente reportada, lo que hace mucho más probable que sea usada en intentos de comprometer sitios por parte de actores malintencionados."

#: includes/insecure-password-screen.php:36
msgid "It is strongly recommended that you change your password."
msgstr "Se recomienda encarecidamente que cambies tu contraseña."

#: includes/insecure-password-screen.php:41
msgid "Change password"
msgstr "Cambiar la contraseña"

#: includes/insecure-password-screen.php:57
msgid "Remind me later"
msgstr "Recuérdamelo después"

#. translators: %s: Human-readable time interval.
#: secure-passwords.php:155
#, php-format
msgid "You will not see an insecure password notice for %s."
msgstr "No verás un aviso de contraseña insegura por los porcentajes."

#: secure-passwords.php:201
msgid "Please choose a different password. The one entered was found in a database of insecure passwords."
msgstr "Por favor, elige una contraseña diferente. La que ingresaste fue encontrada en una base de datos de contraseñas inseguras."
